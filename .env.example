# Copy this file to .env and fill in your values.

# Optional. Get a free key at https://hunter.io (25 searches/mo free).
# If unset, the agent falls back to scraping company contact pages.
HUNTER_API_KEY=

# Ollama model to use for research + copywriting.
OLLAMA_MODEL=qwen2.5

# Path to Google OAuth client secrets (downloaded from Google Cloud Console).
GOOGLE_CREDENTIALS_PATH=credentials/google_client_secret.json

# Where the OAuth token is cached after first login.
GOOGLE_TOKEN_PATH=credentials/google_token.json

# Server port.
PORT=8000
